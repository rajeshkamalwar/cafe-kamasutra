# Copy to deploy/env on the VPS (never commit deploy/env).
# Used by cloudpanel-install.sh

DOMAIN=restaurantkamasutra.nl
SITE_ROOT=/home/YOUR_SITE_USER/htdocs/restaurantkamasutra.nl

# WordPress database (create in CloudPanel → Databases)
WP_DB_NAME=restaurant
WP_DB_USER=restaurant_user
WP_DB_PASS=CHANGE_ME
WP_DB_HOST=127.0.0.1

# Online ordering database
ORDER_DB_NAME=sharma_kama
ORDER_DB_USER=restaurant_user
ORDER_DB_PASS=CHANGE_ME
ORDER_DB_HOST=127.0.0.1

# Git
REPO_URL=https://github.com/rajeshkamalwar/cafe-kamasutra.git
BRANCH=main
